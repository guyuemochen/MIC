+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::model::{Constraint, LinearExpr, Problem, Sense, Tolerances, VarType, Variable};
+    use crate::simplex::{Bounds, LpStatus};
+
+    fn fixture(sense: Sense) -> (Simplex, Bounds) {
+        let p = Problem {
+            name: "出口诊断测试".into(), sense,
+            vars: vec![Variable { name: "x".into(), var_type: VarType::Continuous, lb: 1.0, ub: 3.0 }],
+            obj: LinearExpr { terms: vec![(0, if sense == Sense::Minimize { -2.0 } else { 2.0 })] },
+            obj_offset: 7.0,
+            constraints: vec![Constraint { name: None, expr: LinearExpr { terms: vec![(0, 1.0)] }, op: RelOp::Le, rhs: 2.0 }],
+        };
+        (Simplex::new(&p, Tolerances::default()).unwrap(), Bounds::from_problem(&p))
+    }
+
+    #[test]
+    fn natural_min_max_offset_outputs_are_unchanged() {
+        for sense in [Sense::Minimize, Sense::Maximize] {
+            let (mut original, bounds) = fixture(sense);
+            let mut observed = original.clone();
+            reset(0);
+            let expected = original.solve(&bounds);
+            reset(1);
+            let actual = observed.solve(&bounds);
+            let trace = take();
+            assert_eq!(actual.status, LpStatus::Optimal);
+            assert_eq!(actual.status, expected.status);
+            assert_eq!(actual.objective.to_bits(), expected.objective.to_bits());
+            assert_eq!(actual.x, expected.x);
+            assert_eq!(actual.duals, expected.duals);
+            assert_eq!(observed.basis, original.basis);
+            assert_eq!(observed.matrix, original.matrix);
+            assert_eq!(observed.binv, original.binv);
+            assert_eq!(observed.iterations(), original.iterations());
+            assert_eq!(trace.optimal_calls, 1);
+            assert_eq!(trace.anomalous_calls, 0);
+            assert_eq!(trace.finite_dual_bounds, 1);
+        }
+    }
+
+    #[test]
+    fn clone_does_not_rollback_counts_and_final_downgrades_are_excluded() {
+        let (mut s, bounds) = fixture(Sense::Minimize);
+        reset(0);
+        s.solve(&bounds);
+        let mut clone = s.clone();
+        reset(1);
+        assert_eq!(s.resolve(&bounds).status, LpStatus::Optimal);
+        assert_eq!(clone.resolve(&bounds).status, LpStatus::Optimal);
+        s.rhs[0] = f64::NAN;
+        assert_eq!(s.build_solution(LpStatus::Optimal).status, LpStatus::IterationLimit);
+        let trace = take();
+        assert_eq!(trace.optimal_calls, 2);
+        assert_eq!(trace.anomalous_calls, 0);
+    }
+
+    #[test]
+    fn synthetic_row_corruption_is_sampled_without_changing_return_or_growing_unbounded() {
+        let (mut s, bounds) = fixture(Sense::Minimize);
+        reset(0);
+        s.solve(&bounds);
+        // 人工污染只检验采样覆盖，不是自然误Optimal的证据。
+        s.rhs[0] = 2.5;
+        reset(1);
+        for _ in 0..7 {
+            let result = s.build_solution(LpStatus::Optimal);
+            assert_eq!(result.status, LpStatus::Optimal);
+            assert_eq!(result.x, vec![2.5]);
+            assert_eq!(s.rhs, vec![2.5]);
+        }
+        let trace = take();
+        assert_eq!(trace.optimal_calls, 7);
+        assert_eq!(trace.anomalous_calls, 7);
+        assert_eq!(trace.metrics[2].over_tolerance, 7);
+        assert_eq!(trace.metrics[2].first, Some(1));
+        assert_eq!(trace.metrics[2].last, Some(7));
+        assert_eq!(trace.samples.len(), 4);
+        assert_eq!(trace.later_anomalies_omitted, 3);
+        assert_eq!(trace.snapshot_budget_omitted, 0);
+        assert!(trace.snapshot_bytes <= TOTAL_BYTES);
+        let mut bytes = Vec::new();
+        trace.write_json(&mut bytes).unwrap();
+        let text = String::from_utf8(bytes).unwrap();
+        assert!(text.contains("\"snapshot_complete\":true"));
+        assert!(!text.contains(":NaN") && !text.contains(":inf"));
+    }
+
+    #[test]
+    fn snapshot_estimate_checks_overflow_before_large_allocations() {
+        let (mut s, _) = fixture(Sense::Minimize);
+        assert!(snapshot_estimate(&s, s.num_constraints).unwrap() < SNAPSHOT_BYTES);
+        let before = snapshot_estimate(&s, s.num_constraints).unwrap();
+        s.constraint_row.extend([None; 100]);
+        s.cut_row.extend([None; 100]);
+        assert_eq!(snapshot_estimate(&s, s.num_constraints + 100).unwrap() - before, 300 * 24);
+        s.num_art = usize::MAX;
+        assert_eq!(snapshot_estimate(&s, s.num_constraints), None);
+    }
+}
